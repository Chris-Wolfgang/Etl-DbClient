root = false

[*.cs]

# RS0016/RS0017/RS0037 — PublicApiAnalyzers defaults these BELOW warning on 5.x, so public
# API can drift unrecorded through a fully green build. That is exactly what happened: 41
# symbols were missing when this was raised (#364), including two members removed and never
# recorded as removed. Raising them makes the drift impossible rather than fixed once.
#
# Etl-Csv cannot do this (Chris-Wolfgang/ETL-Csv#263): its record types' compiler-generated
# <Clone>$ members are neither recordable nor suppressible. This repo has no such members —
# verified by harvesting at error severity and getting zero diagnostics — so enforcement is
# available here where it is not there.
#
# TreatWarningsAsErrors is on for Release, so CI treats these as errors while local Debug
# builds still only warn.
dotnet_diagnostic.RS0016.severity = warning
dotnet_diagnostic.RS0017.severity = warning
dotnet_diagnostic.RS0037.severity = warning

# S1133 ("remove this deprecated code someday") — every [Obsolete] member in this
# project is a deliberate deprecation marker for the options-record migration, with a
# dated removal wave (not before 2026-12-15). Sonar cannot know the removal is already
# scheduled, so it reports all 26 of them as open technical debt on every scan. The rule
# is wrong for the whole project until that wave lands; individual false positives
# elsewhere still get an inline #pragma or [SuppressMessage] with a reason.
# Matches Chris-Wolfgang/ETL-FixedWidth#478.
dotnet_diagnostic.S1133.severity = none

# Trim, AOT and single-file analyzers (#415). The root .editorconfig sets
# `dotnet_analyzer_diagnostic.severity = suggestion`, which also demotes the ILLink analyzers'
# IL2xxx / IL3xxx diagnostics to suggestions: they never print and never trip
# TreatWarningsAsErrors, so IsAotCompatible / IsTrimmable in the csproj (net8.0+) on their own
# would check nothing. Raising the three categories here makes a trim or AOT regression in the
# library fail the Release build. Scoped to the library: examples and tests keep the root
# setting. A probe with an unannotated Type.GetProperties() and an AssemblyBuilder call fails
# with IL2070 / IL3050 under these lines and builds clean without them.
dotnet_analyzer_diagnostic.category-Trimming.severity = warning
dotnet_analyzer_diagnostic.category-AOT.severity = warning
dotnet_analyzer_diagnostic.category-SingleFile.severity = warning
