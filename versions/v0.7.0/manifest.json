      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "Wolfgang.Etl.DbClient.RowErrorHandling",
      "Summary": "<p sourcefile=\"api/Wolfgang.Etl.DbClient.RowErrorHandling.yml\" sourcestartlinenumber=\"1\">Controls how <xref href=\"Wolfgang.Etl.DbClient.DbLoader%601\" data-throw-if-not-resolved=\"false\"></xref> reacts when a single row's\n<code>ExecuteAsync</code> call throws.</p>\n"
    },
